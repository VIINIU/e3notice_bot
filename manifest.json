{
    "manifest_version": 3,
    "name": "CAU EEE & DISU notice",
    "version": "1.2",
    "description": "전자전기공학부 및 차세대 반도체 혁신공유대학 최신 공지사항 모니터링",
    "action": {
    "default_popup": "popup.html"
    },
    "background": {
    "service_worker": "background.js"
    },
    "permissions": [
    "alarms",
    "storage",
    "notifications"
    ],
    "host_permissions": [
    "*://*.cau.ac.kr/*",
    "*://*.disu.ac.kr/*"
    ]
}